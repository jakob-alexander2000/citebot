# Required for chat + ingest (Google AI Studio key — never commit the real value)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: OpenAI fallback when Gemini is overloaded (503/429) or the chat model is missing.
# Retrieval embeddings stay on Gemini (gemini-embedding-001) — only generateContent steps use fallback.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional Gemini model overrides
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- White-label brand (all optional; defaults = CiteBot demo) ---
# NEXT_PUBLIC_BRAND_NAME=CiteBot
# NEXT_PUBLIC_BRAND_TAGLINE=Ask the handbook.
# NEXT_PUBLIC_BRAND_TAGLINE_2=Get the source.
# NEXT_PUBLIC_BRAND_ORG=Nordlicht Labs
# NEXT_PUBLIC_BRAND_CORPUS_LABEL=employee handbook
# NEXT_PUBLIC_BRAND_ACCENT=#18181b
# NEXT_PUBLIC_BRAND_INITIAL=C
# NEXT_PUBLIC_BRAND_LOGO_URL=/logo.png
# NEXT_PUBLIC_BRAND_GITHUB_URL=https://github.com/jakob-alexander2000/citebot
# NEXT_PUBLIC_BRAND_FOOTER=Demo corpus only — not legal or HR advice.
# NEXT_PUBLIC_BRAND_DESCRIPTION=Ask a sample employee handbook and get answers with source citation chips.

# Corpus folder relative to project root (markdown *.md and PDF *.pdf).
# CORPUS_DIR=corpus
