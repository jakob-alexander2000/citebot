# Answer core and the /ask chat. If either variable is missing, the app uses
# the deterministic mock and /api/limits reports provider "mock".
# Never commit real values.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# WORKERS_AI_FALLBACK_MODEL=@cf/zai-org/glm-4.7-flash
# WORKERS_AI_EMBED_MODEL=@cf/baai/bge-m3

# Optional Supabase Postgres with pgvector. When unset, the preview keeps the
# handbook index in memory (and a local file outside tests). Uploaded PDFs are
# never written there.
# DATABASE_URL=

# Handbook folder relative to the project root. Default is examples/nordlicht-corpus.
# CORPUS_DIR=examples/nordlicht-corpus

# Optional event forward. POST /api/events works with nothing set.
# Question text is not stored.
# ANALYTICS_URL=https://collector.example/events
# PLAUSIBLE_DOMAIN=citebot.example
# PLAUSIBLE_API_HOST=https://plausible.io
# VERCEL_ANALYTICS_URL=https://collector.example/vercel
