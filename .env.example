# Required for chat + ingest (Google AI Studio key — never commit the real value)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: OpenAI fallback when Gemini is overloaded (503/429) or the chat model is missing.
# Retrieval embeddings stay on Gemini (gemini-embedding-001) — only generateContent steps use fallback.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional Gemini model overrides
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- White-label brand (all optional; defaults = Grounded Docs QM handbook) ---
# Tagline, corpus label, footer, and description follow DE/EN when unset.
# Locale switch: on for Grounded Docs / QM, off for CiteBot and any other brand name.
# Opt a client into DE|EN with NEXT_PUBLIC_BILINGUAL=true, or force English with false.
# NEXT_PUBLIC_BILINGUAL=
# Skin override if the name should not decide it: product | craft | client
# NEXT_PUBLIC_BRAND_SKIN=
# NEXT_PUBLIC_BRAND_NAME=Grounded Docs
# NEXT_PUBLIC_BRAND_TAGLINE=Ask the quality handbook.
# NEXT_PUBLIC_BRAND_TAGLINE_2=See the source.
# NEXT_PUBLIC_BRAND_ORG=Hartmann Fertigung GmbH
# NEXT_PUBLIC_BRAND_CORPUS_LABEL=quality handbook
# NEXT_PUBLIC_BRAND_ACCENT=#0f4c45
# NEXT_PUBLIC_BRAND_INITIAL=G
# NEXT_PUBLIC_BRAND_LOGO_URL=/logo.png
# NEXT_PUBLIC_BRAND_GITHUB_URL=https://github.com/jakob-alexander2000/citebot
# NEXT_PUBLIC_BRAND_FOOTER=Sample QM handbook — not a certified management system or legal advice.
# NEXT_PUBLIC_BRAND_DESCRIPTION=Grounded Docs answers quality-handbook questions in German or English, with citations and an evidence check.

# Corpus folder relative to project root (markdown *.md and PDF *.pdf).
# CORPUS_DIR=corpus

# --- Events (optional). POST /api/events works with nothing set. ---
# Ring in this process, .cache/events.jsonl when writable, one JSON line on stdout.
# Question text is not stored. See /growth.
# ANALYTICS_URL=https://collector.example/events
# PLAUSIBLE_DOMAIN=citebot.example
# PLAUSIBLE_API_HOST=https://plausible.io
# VERCEL_ANALYTICS_URL=https://collector.example/vercel
