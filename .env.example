# Required for chat (Google AI Studio key — never commit the real value)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: OpenAI fallback when Gemini is overloaded (503/429) or the chat model is missing.
# Retrieval embeddings stay on Gemini (gemini-embedding-001).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional Gemini model overrides
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# Handbook folder relative to the project root. Default is examples/nordlicht-corpus.
# CORPUS_DIR=examples/nordlicht-corpus

# Optional event forward. POST /api/events works with nothing set.
# Question text is not stored.
# ANALYTICS_URL=https://collector.example/events
# PLAUSIBLE_DOMAIN=citebot.example
# PLAUSIBLE_API_HOST=https://plausible.io
# VERCEL_ANALYTICS_URL=https://collector.example/vercel
